# Add this to %USERPROFILE%\.codex\config.toml
# Keep your existing DeepSeek profile/config unchanged.

[model_providers.gemini-proxy]
name = "gemini-proxy"
base_url = "http://localhost:8765/v1"
wire_api = "responses"
experimental_bearer_token = "local-proxy"

[profiles.gemini]
model_provider = "gemini-proxy"
model = "gemini-3.8-flash"
